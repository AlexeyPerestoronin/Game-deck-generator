@page {
  size: {{ card_width_mm }}mm {{ card_height_mm }}mm;
  margin: 0;
}

html,
body {
  margin: 0;
  padding: 0;
  width: {{ card_width_mm }}mm;
  height: {{ card_height_mm }}mm;
  background: #fff;
}

.card {
  position: relative;
  box-sizing: border-box;
  width: {{ card_width_mm }}mm;
  height: {{ card_height_mm }}mm;
  overflow: hidden;
  color: #000;
  background: #fff;
  font-family: "Times New Roman", Times, serif;
  border: 1mm solid #000;
  border-radius: 3mm;
  break-after: page;
  page-break-after: always;

  &:last-child {
    break-after: auto;
    page-break-after: auto;
  }
}

.header {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 6.667%;
  display: grid;
  grid-template-columns: 20% 55% 25%;
  box-sizing: border-box;
  border-bottom: 0.5mm solid #000;

  .cell {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-width: 0;
    padding: 0 0.8mm;
    font-size: 12pt;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
  }

  .name {
    justify-content: center;
    border-right: 0.5mm solid #000;
    white-space: normal;

    span {
      display: block;
      flex: 1 1 0;
      min-width: 0;
      width: 100%;
      overflow: hidden;
      text-align: center;
      white-space: normal;
      overflow-wrap: break-word;
      line-height: 1.1;
    }
  }
}

.box {
  position: absolute;
  box-sizing: border-box;
  border: 0.5mm solid #000;
  border-radius: 1mm;

  &-desc {
    left: 5%;
    top: 10%;
    width: 90%;
    height: 16.667%;
  }

  &-effects {
    left: 5%;
    top: 30%;
    width: 90%;
    height: 66.667%;
  }
}

.desc-text {
  position: absolute;
  left: 10%;
  top: 13.333%;
  width: 80%;
  height: 10%;
  overflow: hidden;
  font-size: 8pt;
  line-height: 1.25;
  text-align: left;
}

.effects-text {
  position: absolute;
  left: 10%;
  top: 33.333%;
  width: 80%;
  height: 60%;
  overflow: hidden;
  font-size: 8pt;
  line-height: 1.3;

  ul {
    margin: 0;
    padding-left: 1.15em;
  }

  li {
    margin: 0 0 0.45em;
  }
}
