{
    // all paths are relative to the folder of this file

    "game-name": "monopoly-2.0",

    "folders": {
        "decks": "decks",
        "views": "views",
        "vars": "vars",
        "rules": "rules",
        "autogenerated": "_autogenerated",
        "duplex": "_autogenerated/a4-duplex"
    },

    "output": {
        "face_html": "face.html",
        "back_html": "back.html",
        "preview_html": "preview.html",
        "face_pdf": "face.pdf",
        "back_pdf": "back.pdf",
        "duplex_pdf": "a4-duplex.pdf"
    },

    "print": {
        "default_duplex": "long-edge",
        "page_width_mm": 210.0,
        "page_height_mm": 297.0,
        "cols": 3,
        "rows": 3,
        "gap_x_mm": 5.0,
        "gap_y_mm": 5.0,
        "crop_mark_mm": 2.0,
        "crop_mark_gap_mm": 0.8,
        "crop_mark_thickness_pt": 0.3
    },
}
