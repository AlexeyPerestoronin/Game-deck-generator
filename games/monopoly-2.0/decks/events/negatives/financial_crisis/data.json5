{
    "name": "monopoly.events.negatives.financial_crisis",
    "view": {
        "face": "event-face.html",
        "back": "event-back.html"
    },
    "deck": {
        "game_name": "Монополия ${game:game-version}",
        "title": "Негативное событие",
        "category": "«${game:decks.events.negative.financial-crisis.category}»",
        "card_width_mm": ${game:decks.professions.card-width},
        "card_height_mm": ${game:decks.professions.card-height}
    },
    "cards": [
        {
            "name": "падение прибылей I",
            "from": 0,
            "to": ${game:life-time},
            "description": "экономику трясёт, доходы падают",
            "life-effects": [
                "на 1 следующий ход любой доход всех игроков уменьшается на 2 (расходы остаются прежними)"
            ]
        },
        {
            "name": "падение прибылей II",
            "from": 0,
            "to": ${game:life-time},
            "description": "экономику трясёт, доходы падают",
            "life-effects": [
                "на 3 следующих хода любой доход всех игроков уменьшается на 2 (расходы остаются прежними)"
            ]
        },
        {
            "name": "падение прибылей III",
            "from": 0,
            "to": ${game:life-time},
            "description": "экономику трясёт, доходы падают",
            "life-effects": [
                "на 3 следующих хода любой доход всех игроков уменьшается на 3 (расходы остаются прежними)"
            ]
        },
        {
            "name": "сокращение зарплат",
            "from": 0,
            "to": ${game:life-time},
            "description": "компании режут оклады, чтобы удержаться на плаву",
            "life-effects": [
                "на 2 следующих хода доход профессии всех игроков уменьшается в 2 раза"
            ]
        },
        {
            "name": "отзыв кредитов",
            "from": 0,
            "to": ${game:life-time},
            "description": "банки требуют деньги обратно и закрывают лимиты",
            "life-effects": [
                "каждый игрок сразу платит 100"
            ]
        },
        {
            "name": "дорогие товары",
            "from": 0,
            "to": ${game:life-time},
            "description": "цены растут, жить становится тяжелее",
            "life-effects": [
                "на 3 следующих хода все платежи игроков увеличиваются в 2 раза (доходы остаются прежними)"
            ]
        },
        {
            "name": "биржевой крах",
            "from": 0,
            "to": ${game:life-time},
            "description": "рынки падают, накопления сгорают",
            "life-effects": [
                "каждый игрок сразу платит 100\u00a0*\u00a0${game:liters.game-time}",
            ]
        },
        {
            "name": "массовые увольнения I",
            "from": 0,
            "to": ${game:life-time},
            "description": "предприятия сокращают штат, лишних не держат",
            "life-effects": [
                "верните дополнительную профессию, если она у вас есть",
                "на 3 следующих хода нельзя иметь дополнительную профессию"
            ]
        },
        {
            "name": "массовые увольнения II",
            "from": 0,
            "to": ${game:life-time},
            "description": "предприятия сокращают штат, лишних не держат",
            "life-effects": [
                "если у вас есть профессия, то бросьте кубик и:",
                "- 1-3 - вы сохранили профессию",
                "- 4-6 - вы потеряли профессию",
            ]
        }
    ]
}
