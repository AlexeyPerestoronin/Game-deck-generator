{
    "name": "monopoly.events.negatives.real_estate_crisis",
    "view": {
        "face": "event-face.html",
        "back": "event-back.html"
    },
    "deck": {
        "game_name": "Монополия ${game:game-version}",
        "title": "Негативное событие",
        "category": "«${game:decks.events.negative.real-estate-crisis.category}»",
        "card_width_mm": ${game:decks.professions.card-width},
        "card_height_mm": ${game:decks.professions.card-height}
    },
    "cards": [
        {
            "name": "падение цен I",
            "from": 0,
            "to": ${game:life-time},
            "description": "квартиры дешевеют, сдавать их уже невыгодно",
            "life-effects": [
                "на 1 следующий ход доход от недвижимости всех игроков уменьшается на 2 (расходы остаются прежними)"
            ]
        },
        {
            "name": "падение цен II",
            "from": 0,
            "to": ${game:life-time},
            "description": "рынок просел, арендаторы просят скидку",
            "life-effects": [
                "на 3 следующих хода доход от недвижимости всех игроков уменьшается на 2 (расходы остаются прежними)"
            ]
        },
        {
            "name": "падение цен III",
            "from": 0,
            "to": ${game:life-time},
            "description": "цены рухнули, объекты почти ничего не приносят",
            "life-effects": [
                "на 3 следующих хода доход от недвижимости всех игроков уменьшается на 3 (расходы остаются прежними)"
            ]
        },
        {
            "name": "ипотечный кризис",
            "from": 0,
            "to": ${game:life-time},
            "description": "банки требуют досрочное погашение жилищных кредитов",
            "life-effects": [
                "каждый игрок, у которого есть недвижимость, сразу платит $s{кол.дом * 25 * ${game:liters.game-time}}",
                "если у вас нет недвижимости, вы не платите"
            ]
        },
        {
            "name": "рост ставок",
            "from": 0,
            "to": ${game:life-time},
            "description": "кредит на жильё становится неподъёмным",
            "life-effects": [
                "на 3 следующих хода все платежи за недвижимость увеличиваются в 2 раза"
            ]
        },
        {
            "name": "заморозка строек",
            "from": 0,
            "to": ${game:life-time},
            "description": "площадки стоят, новые дома не закладывают",
            "life-effects": [
                "3 следующих хода нельзя строить"
            ]
        },
        {
            "name": "арендный коллапс",
            "from": 0,
            "to": ${game:life-time},
            "description": "съёмщики съезжают, квартиры пустуют",
            "life-effects": [
                "на 2 следующих хода доход от аренды всех игроков равен 0"
            ]
        },
        {
            "name": "изъятие залога",
            "from": 0,
            "to": ${game:life-time},
            "description": "кто не платит по ипотеке — теряет жильё",
            "life-effects": [
                "каждый игрок с недвижимостью бросает 1 кубик:",
                "→ 1–3: верните одну карточку недвижимости в банк",
                "→ 4–6: заплатите $s{100 * ${game:liters.game-time}} и сохраните имущество"
            ]
        },
        {
            "name": "обвал рынка",
            "from": 0,
            "to": ${game:life-time},
            "description": "стоимость квадратного метра падает вместе с накоплениями",
            "life-effects": [
                "каждый игрок сразу платит $s{80 * ${game:liters.game-time}}",
                "если у вас нет недвижимости, вы не платите"
            ]
        }
    ]
}
