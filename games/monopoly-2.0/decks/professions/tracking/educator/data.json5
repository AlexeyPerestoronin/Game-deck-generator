        },
        {
            "name": ${vars.level-names.l-2},
            "level": 2,
            "entrance": 55,
            "description": "вы ведёте уроки в школе и занимаетесь с детьми после звонка",
            "life-effects": [
                "доход = 70/ход",
                "репетиторство: если в ваш ход выпало число больше 8, получите 40",
                "бонус к броску на поле социального капитала +2",
