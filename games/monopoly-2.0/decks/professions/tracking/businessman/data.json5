    },
    "vars": {
        "level-names": {
            "l-1": "самозанятый",
            "l-2": "индивидуальный предприниматель",
            "l-3": "владелец малого бизнеса",
            "l-4": "директор компании",
            "l-5": "владелец холдинга",
            "l-6": "инвестор",
            "l-7": "магнат",
            "l-8": "глава торгово-промышленной палаты"
