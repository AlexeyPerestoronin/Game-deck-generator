        },
        {
            "name": ${vars.level-names.l-7},
            "level": 7,
            "entrance": 374,
            "description": "ваш капитал определяет целые отрасли",
            "life-effects": [
                "доход = $s{1000 + 200 * ${game:liters.step-quantity}}/ход",
