{
    "name": "monopoly.professions.tracking.chemist",
    "view": {
        "face": "profession-face.html",
        "back": "career-back.html"
    },
    "vars": {
        "level-names": {
            "l-1": "увлечённый химией",
            "l-2": "лаборант химии",
            "l-3": "ассистент кафедры химии",
            "l-4": "кандидат химических наук",
            "l-5": "доктор химических наук",
            "l-6": "руководитель химической лаборатории",
            "l-7": "изобретатель",
            "l-8": "лауреат «Нобелевской премии»"
        }
    },
    "deck": {
        "game_name": "Монополия ${game:game-version}",
        "title": "Карьерный путь",
        "category": "«Химик»",
        "card_width_mm": ${game:decks.professions.card-width},
        "card_height_mm": ${game:decks.professions.card-height}
    },
    "cards": [
        {
            "name": ${vars.level-names.l-1},
            "level": 1,
            "entrance": 50,
            "description": "вы ставите опыты на кухне и ведёте тетрадь реакций",
            "life-effects": [
                "доход = 10/ход",
                "можно совмещать с любой другой профессией",
            ]
        },
        {
            "name": ${vars.level-names.l-2},
            "level": 2,
            "entrance": 87,
            "description": "вы готовите растворы и пишете протоколы в институтской лаборатории",
            "life-effects": [
                "доход = 50/ход"
            ]
        },
        {
            "name": ${vars.level-names.l-3},
            "level": 3,
            "entrance": 145,
            "description": "вы ведёте синтезы по чужим методикам и мечтаете о своём патенте",
            "life-effects": [
                "доход = 80/ход",
                "бонус к броску на поле социального капитала +1",
            ]
        },
        {
            "name": ${vars.level-names.l-4},
            "level": 4,
            "entrance": 157,
            "description": "выходите на свои формулы и начинаете патентовать",
            "life-effects": [
                "доход = 90/ход",
                "доход с патентов = $s{10 * кол.пат * ${game:liters.step-quantity}}/ход",
                "новый патент: если в ваш ход выпало число больше 10",
                "бонус к броску на поле социального капитала +2",
            ]
        },
        {
            "name": ${vars.level-names.l-5},
            "level": 5,
            "entrance": 247,
            "description": "ваши вещества уже покупают производства",
            "life-effects": [
                "доход = 140/ход",
                "доход с патентов = $s{20 * кол.пат * ${game:liters.step-quantity}}/ход",
                "новый патент: если в ваш ход выпало число больше 8",
                "бонус к броску на поле социального капитала +3",
            ]
        },
        {
            "name": ${vars.level-names.l-6},
            "level": 6,
            "entrance": 264,
            "description": "лаборатория работает на ваш портфель патентов",
            "life-effects": [
                "доход = 250/ход",
                "доход с патентов = $s{40 * кол.пат * ${game:liters.step-quantity}}/ход",
                "новый патент: если в ваш ход выпало число больше 6",
                "бонус к броску на поле социального капитала +4",
            ]
        },
        {
            "name": ${vars.level-names.l-7},
            "level": 7,
            "entrance": 357,
            "description": "вы синтезировали вещество, которого ещё не было в природе",
            "life-effects": [
                "доход с патентов = $s{50 * кол.пат * ${game:liters.step-quantity}}/ход",
                "новый патент: если в ваш ход выпало число больше 6",
                "бонус к броску на поле социального капитала +4",
                "можно совмещать с любой другой профессией",
                "по желанию бросьте 1 кубик и если:",
                " - 1-4 - синтез не удался",
                " - 5   - взрыв в лаборатории: заплатите 1500",
                " - 6   - удача: получите достижение $s{«${achieves:new-compound}»}",
            ]
        },
        {
            "name": ${vars.level-names.l-8},
            "level": 8,
            "entrance": 250,
            "description": "вас номинировали на Нобелевскую премию по химии",
            "life-effects": [
                "бросьте 2 кубика и, если выпадет дубль, получите достижение $s{«${achieves:NP-in-chemistry}»}",
            ]
        }
    ]
}
