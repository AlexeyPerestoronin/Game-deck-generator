{
    "name": "new-game.deck-1st",
    "view": {
        "face": "simple-front.html",
        "back": "simple-back.html"
    },
    "deck": {
        "game_name": "${game:name}",
        "title": "First deck",
        "category": "Deck 1",
        "card_width_mm": ${card:width_mm},
        "card_height_mm": ${card:height_mm}
    },
    "cards": [
        {
            "name": "Literal card",
            "description": "This card uses no placeholders. Edit the text as-is."
        },
        {
            "name": "Sized card",
            "description": "This card reads only card.json5: ${card:width_mm}×${card:height_mm} mm, label ${card:sample_label}."
        }
    ]
}
