{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "console": "integratedTerminal",
    "configurations": [
        {
            "name": "Debug invoke-task",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "invoke",
            "cwd": "${workspaceFolder}",
            "args": [
                "export.professions.prepare-html",
            ],
        },
        // "projects.casket.prepare-metal-manufacturing-doc"
        // "projects.punch-guide-holder.prepare-metal-manufacturing-doc"
        {
            "name": "Profile invoke-task",
            "type": "debugpy",
            "request": "launch",
            "module": "cProfile", // Указываем VS Code запустить профилировщик как модуль
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "-o", "${workspaceFolder}/invoke_task.prof", // Файл отчета
                "-m",
                    "invoke",
                        "export.professions.prepare-html",
            ],
        }

    ]
}