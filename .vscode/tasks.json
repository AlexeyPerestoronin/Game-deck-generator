{
    "version": "2.0.0",
    "presentation": {
        "reveal": "always",
        "panel": "shared"
    },
    "problemMatcher": [],
    "tasks": [
        {
            "label": "YAPF",
            "type": "shell",
            "group": "none",
            "command": "${workspaceFolder}/.venv/Scripts/yapf.exe",
            "args": [
                "--style",
                "${workspaceFolder}/.style.yapf",
                "--recursive",
                "--in-place",
                "--parallel",
                "${workspaceFolder}",
                "--exclude",
                "${workspaceFolder}/.venv/**",
                "--exclude",
                "${workspaceFolder}/Projects/**",
                "--exclude",
                "${workspaceFolder}/WiKi/**"
            ],
        },
        {
            "label": "Remove python cache files",
            "type": "shell",
            "group": "none",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m", "invoke", "tools.remove-python-cache",
            ],
        }
    ]
}