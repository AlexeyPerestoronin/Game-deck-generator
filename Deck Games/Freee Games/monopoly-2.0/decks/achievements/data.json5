        },
        {
            "status": "${achieves:NP-in-genetics}",
            "description": "вы расширили горизонты человеческого знания о том, как устроен геном человека",
            "life-effects": [
                "получите 10.000"
            ]
        },
        {
            "status": "${achieves:full-dossier}",
            "description": "у вас на руках досье на всех, кто имеет значение",
