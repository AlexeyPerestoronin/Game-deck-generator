{
    "name": "monopoly.events.negatives.pandemic",
    "view": {
        "face": "event-face.html",
        "back": "event-back.html"
    },
    "deck": {
        "game_name": "Монополия ${game:game-version}",
        "title": "Негативное событие",
        "category": "«${game:decks.events.negative.pandemic.category}»",
        "card_width_mm": ${game:decks.professions.card-width},
        "card_height_mm": ${game:decks.professions.card-height}
    },
    "cards": [
        {
            "name": "эпидемия I",
            "from": 0,
            "to": ${game:life-time},
            "description": "по городу распространяется болезнь",
            "life-effects": [
                "на 1 следующий ход все игроки считаются заболевшими",
                "заболевшие не получают доход профессии в этот ход"
            ]
        },
        {
            "name": "эпидемия II",
            "from": 0,
            "to": ${game:life-time},
            "description": "болезнь держится, аптеки не справляются",
            "life-effects": [
                "на 3 следующих хода все игроки считаются заболевшими",
                "заболевшие не получают доход профессии"
            ]
        },
        {
            "name": "эпидемия III",
            "from": 0,
            "to": ${game:life-time},
            "description": "тяжёлая волна, болеют почти все",
            "life-effects": [
                "на 3 следующих хода все игроки считаются заболевшими",
                "любой доход всех игроков равен 0 (расходы остаются прежними)"
            ]
        },
        {
            "name": "карантин",
            "from": 0,
            "to": ${game:life-time},
            "description": "город закрывают, выходить нельзя",
            "life-effects": [
                "на 3 следующих хода нельзя взять или сменить профессию",
                "любой доход всех игроков уменьшается в 2 раза"
            ]
        },
        {
            "name": "обязательное лечение",
            "from": 0,
            "to": ${game:life-time},
            "description": "без лекарств и справки на работу не пускают",
            "life-effects": [
                "каждый игрок сразу платит 50 * Q за лечение"
            ]
        },
        {
            "name": "дефицит лекарств",
            "from": 0,
            "to": ${game:life-time},
            "description": "в аптеках пустые полки, цены растут",
            "life-effects": [
                "на 3 следующих хода все платежи игроков увеличиваются в 2 раза (доходы остаются прежними)"
            ]
        },
        {
            "name": "локдаун",
            "from": 0,
            "to": ${game:life-time},
            "description": "магазины и офисы закрыты на недели",
            "life-effects": [
                "на 2 следующих хода любой доход всех игроков уменьшается в 2 раза",
                "на это время нельзя иметь дополнительную профессию"
            ]
        },
        {
            "name": "переполненные больницы",
            "from": 0,
            "to": ${game:life-time},
            "description": "мест нет, лечиться дорого",
            "life-effects": [
                "каждый игрок сразу платит $s{40 * ${game:liters.game-time}} за лечение"
            ]
        },
        {
            "name": "волна заражений",
            "from": 0,
            "to": ${game:life-time},
            "description": "болезнь вспыхивает то здесь, то там",
            "life-effects": [
                "каждый игрок бросает 1 кубик:",
                "→ 1–3: вы заболели на 2 хода и не получаете доход профессии",
                "→ 4–6: вы здоровы"
            ]
        }
    ]
}
