                "вы можете освободить из тюрьмы любого игрока с социальным капиталом меньше вашего",
                "на вас не действуют эффекты карточек «${game:decks.events.negative.prison.category}»",
            ]
        },
        {
            "name": ${vars.level-names.l-6},
