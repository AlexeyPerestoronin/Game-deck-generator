                "доход = 140/ход"
            ]
        },
        {
            "name": ${vars.level-names.l-4},
            "level": 4,
            "entrance": 161,
            "description": "вы выносите приговоры и решения в районном суде",
            "life-effects": [
                "доход = 280/ход",
                "вы можете освободить из тюрьмы любого игрока с социальным капиталом меньше вашего",
