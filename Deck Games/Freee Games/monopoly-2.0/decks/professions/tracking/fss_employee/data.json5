    "cards": [
        {
            "name": ${vars.level-names.l-1},
            "level": 1,
            "entrance": 47,
            "description": "вы читаете закрытые сводки и мечтаете служить в органах",
            "life-effects": [
                "доход = 15/ход",
                "можно совмещать с любой другой профессией",
            ]
        },
        {
            "name": ${vars.level-names.l-2},
            "level": 2,
            "entrance": 74,
            "description": "вы ведёте наружное наблюдение и пишете рапорты",
            "life-effects": [
                "доход = 70/ход",
                "операция: если в ваш ход выпало число больше 6, получите 40",
            ]
        },
        {
            "name": ${vars.level-names.l-3},
            "level": 3,
            "entrance": 101,
            "description": "вы ведёте агентуру и собираете компромат",
            "life-effects": [
                "доход = 110/ход",
                "бонус к броску на поле физического капитала +1",
                "операция: если в ваш ход выпало число больше 6, получите 100",
            ]
        },
        {
            "name": ${vars.level-names.l-4},
            "level": 4,
            "entrance": 179,
            "description": "вам дают дела, о которых нельзя говорить вслух",
            "life-effects": [
                "доход = 160/ход",
                "бонус к броску на поле физического капитала +2",
                "операция: если в ваш ход выпало число больше 6, выберите игрока — он платит вам 150",
            ]
        },
        {
            "name": ${vars.level-names.l-5},
            "level": 5,
            "entrance": 206,
            "description": "вы курируете целое направление и решаете, кого взять в разработку",
            "life-effects": [
                "доход = 280/ход",
                "бонус к броску на поле физического капитала +3",
                "операция: если в ваш ход выпало число больше 6, выберите игрока — он платит вам 300",
                "на вас не действуют эффекты карточек «${game:decks.events.negative.financial-crisis.category}»",
            ]
        },
        {
            "name": ${vars.level-names.l-6},
            "level": 6,
            "entrance": 293,
            "description": "вы входите в узкий круг, которому докладывают всё",
            "life-effects": [
                "доход = 450/ход",
                "бонус к броску на поле физического капитала +4",
                "операция: если в ваш ход выпало число больше 6, выберите игрока — он платит вам 500",
                "на вас не действуют эффекты карточек «${game:decks.events.negative.financial-crisis.category}»",
            ]
        },
        {
            "name": ${vars.level-names.l-7},
            "level": 7,
            "entrance": 362,
            "description": "вы возглавляете службу и запускаете операции государственной важности",
            "life-effects": [
                "доход = 1500/ход",
                "бонус к броску на поле физического капитала +5",
                "на вас не действуют эффекты карточек «${game:decks.events.negative.financial-crisis.category}»",
                "по желанию, бросьте 1 кубик и если:",
                " - 1,2 - провал: операция сорвана",
                " - 3,4 - провал: вас вызвали 'на ковёр', заплатите 1500",
                " - 5   - удача: получите достижение $s{«${achieves:full-dossier}»}",
                " - 6   - удача: вы можете присвоить себе любую собственность любого игрока уровня не выше 5",
            ]
        },
        {
            "name": ${vars.level-names.l-8},
            "level": 8,
            "entrance": 483,
            "description": "вас не видно, но без вашей визы не принимают ни одного решения",
            "life-effects": [
                "доход = $s{400 * ${game:liters.step-quantity}/ход}",
                "бонус к броску на поле физического капитала +1-10",
                "на вас не действуют эффекты карточек «${game:decks.events.negative.financial-crisis.category}»",
                "по желанию, бросьте 1 кубик и если:",
                " - 1,2 - ничего",
                " - 3   - возьмите любую собственность у любого игрока",
                " - 4   - возьмите 5000 у любого игрока",
                " - 5   - посадите любого игрока в тюрьму на 3 хода",
                " - 6   - вас убили (вы проиграли)",
            ]
        }
    ]
