        },
        {
            "name": ${vars.level-names.l-2},
            "level": 2,
            "entrance": 98,
            "description": "вы преподаёте факультативную биологию в школе у дома",
            "life-effects": [
                "доход = 60/ход"
            ]
        },
        {
            "name": ${vars.level-names.l-3},
            "level": 3,
            "entrance": 140,
            "description": "вы работаете в медицинском институте на кафедре биотехнологий",
            "life-effects": [
                "доход = 90/ход",
                "бонус к броску на поле социального капитала +1",
            ]
        },
        {
            "name": ${vars.level-names.l-4},
            "level": 4,
            "entrance": 180,
            "description": "вы ставите генетические диагнозы и консультируете врачей",
            "life-effects": [
                "доход = 150/ход",
                "бонус к броску на поле социального капитала +2",
            ]
        },
        {
            "name": ${vars.level-names.l-5},
            "level": 5,
            "entrance": 243,
            "description": "вы изучаете наследственность и расшифровываете ДНК",
            "life-effects": [
                "доход = 320/ход",
                "бонус к броску на поле социального капитала +3",
            ]
        },
        {
            "name": ${vars.level-names.l-6},
            "level": 6,
            "entrance": 273,
            "description": "вы руководите лабораторией и её проектами",
            "life-effects": [
                "доход = 500/ход",
                "бонус к броску на поле социального капитала +4",
                "можно совмещать с любой другой профессией",
            ]
        },
        {
            "name": ${vars.level-names.l-7},
            "level": 7,
            "entrance": 300,
            "description": "вы пробуете клонировать самого себя",
            "life-effects": [
                "бросьте 1 кубик и если:",
                " - 1,2 - неудача",
                " - 3,4 - неудача: вас оштрафовали на 2000",
                " - 5   - удача: получите достижение $s{«${achieves:first-clone}»}",
                " - 6   - удача: вы получаете возможность кидать 3 кубика в ход",
            ]
