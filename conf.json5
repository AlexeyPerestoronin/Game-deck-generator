{
  // Paths are relative to this file (the repository root).
  // Changing this file does not require recompiling deck_gen.

  "deck_data_files": ["data.json5", "data.json"],
  "vars_file_extensions": [".json5", ".json"],
  "local_vars_dir": "vars",

  "output": {
    "face_html": "face.html",
    "back_html": "back.html",
    "preview_html": "preview.html",
    "manifest": "manifest.json",
    "face_pdf": "face.pdf",
    "back_pdf": "back.pdf",
    "duplex_pdf": "a4-duplex.pdf"
  },

  "print": {
    "default_duplex": "long-edge",
    "page_width_mm": 210.0,
    "page_height_mm": 297.0,
    "cols": 3,
    "rows": 3,
    "gap_x_mm": 5.0,
    "gap_y_mm": 5.0,
    "crop_mark_mm": 2.0,
    "crop_mark_gap_mm": 0.8,
    "crop_mark_thickness_pt": 0.3
  },

  "chrome": {
    "env_vars": ["CHROME_PATH", "CHROMIUM_PATH"],
    "executables": [
      "C:/Program Files/Google/Chrome/Application/chrome.exe",
      "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe",
      "C:/Program Files/Microsoft/Edge/Application/msedge.exe",
      "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
    ],
    "home_relative": [
      "AppData/Local/Google/Chrome/Application/chrome.exe"
    ]
  },

  "games_root": "games",
  "default_game": "monopoly",
  "templates": {
    "default_face": "profession-face.html",
    "default_back": "simple-back.html",
    "preview": "preview.html"
  },
  "games": {
    "monopoly": {
      "dir": "monopoly-2.0",
      "decks": "decks",
      "views": "views",
      "vars": "vars",
      "rules": "rules",
      "autogenerated": "_autogenerated",
      "duplex": "_autogenerated/a4-duplex"
    },
    "new-game": {
      "dir": "new-game",
      "decks": "decks",
      "views": "views",
      "vars": "vars",
      "rules": "rules",
      "autogenerated": "_autogenerated",
      "duplex": "_autogenerated/a4-duplex"
    }
  }
}
