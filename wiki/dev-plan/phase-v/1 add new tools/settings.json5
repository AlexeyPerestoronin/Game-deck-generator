{
    // repo settings
    "cwd": "C:/MyLife/Game-deck-generator",
    "paths": {
        "log-folder": ".log"
    },
    // agent's settings
    "mode": "auto accept",
    "vendor": "SpaceXAI",
    "model": {
        "name": "Grok 4.6",
        "token-limit": 128000,
        "USD-limit": 0.5
    },
    "tool-settings": {
        // "cwd": "current working directory for tools"
        // "temp-dir": "directory for temporary files collecting",
        "shell": [
            "r:findstr",
        ],
        dirs: [
            // minimal scope
            "w:tools/harness/agents/tools",
            // task dir
            "w:WiKi/dev-plan/phase-v/1 add new tools",
            // rules and roles
            "r:WiKi/harness/rules",
            "r:WiKi/harness/roles",
        ],
        "files": [
        ],
        "available-file-extensions": [
            // empty list meant allow all extensions
            // ".md",
            // ".py",
        ]
    },
    "iteration-limit": 50,
    "token-limit": 0,
    // target prompt like entry point
    "prompt": "Необходимо решить задача: см. WiKi/dev-plan/phase-v/1 add new tools/todo.md",
}