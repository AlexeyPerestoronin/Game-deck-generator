{
    // repo settings
    "cwd": "C:/MyLife/Game-deck-generator",
    "paths": {
        "log-folder": ".log"
    },
    // agent's settings
    "mode": "auto accept",
    "vendor": "SpaceXAI",
    "model": "Grok 4.6",
    "tool-settings": {
        // "cwd": "current working directory for tools"
        // "temp-dir": "directory for temporary files collecting",
        "shell": [
            "r:findstr",
            "w:invoke",
        ],
        dirs: [
            // minimal directory scope
            "w:WiKi/dev-plan/phase-IV/14 implement inovke tasks for rust crate testing",
            // rules and roles
            "r:WiKi/harness/rules",
            "r:WiKi/harness/roles",
        ],
        "files": [
            "w:tools/__init__.py"
        ],
        "available-file-extensions": [
            // empty list meant allow all extensions
            // ".md",
            // ".py",
        ]
    },
    "iteration-limit": 50,
    "token-limit": 0,
    // target prompt like entry point
    "prompt": "Есть задача: см. WiKi/dev-plan/phase-IV/14 implement inovke tasks for rust crate testing/todo.md",
}