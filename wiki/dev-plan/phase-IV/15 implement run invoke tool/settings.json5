{
    // repo settings
    "cwd": "C:/MyLife/Game-deck-generator",
    "paths": {
        "log-folder": ".log"
    },
    // agent's settings
    "mode": "safe",
    "vendor": "SpaceXAI",
    "model": {
        "name": "Grok 4.6",
        "token-limit": 128000,
        "USD-limit": 0.5
    },
    "tool-settings": {
        // "cwd": "current working directory for tools"
        // "temp-dir": "directory for temporary files collecting",
        "shell": [
            "r:findstr",
        ],
        dirs: [
            // minimal scope
            "w:tools/harness/agents/tools",
            // minimal scope
            "w:WiKi/dev-plan/phase-IV/15 implement run invoke tool",
            // rules and roles
            "r:WiKi/harness/rules",
            "r:WiKi/harness/roles",
        ],
        "files": [
        ],
        "available-file-extensions": [
            // empty list meant allow all extensions
            ".md",
            ".py",
        ]
    },
    "iteration-limit": 50,
    "token-limit": 0,
    // target prompt like entry point
    "prompt": "Есть задача: см. WiKi/dev-plan/phase-IV/15 implement run invoke tool/todo.md. Надо проверить: читай `# Дополнительная задача: проверить доступность invoke команд`",
}